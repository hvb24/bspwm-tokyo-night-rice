<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1751607861541793-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>com.visualstudio.code</icon>
	<name>Open in VS Code</name>
	<submenu></submenu>
	<unique-id>1764000000000001-1</unique-id>
	<command>code %f</command>
	<description>Open the selected file or folder in VS Code</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as Wallpaper</name>
	<submenu></submenu>
	<unique-id>1764000000000002-2</unique-id>
	<command>~/.config/theme/wallpaper.sh set %f</command>
	<description>Use this image as the desktop wallpaper</description>
	<range>1</range>
	<patterns>*.jpg;*.jpeg;*.png;*.JPG;*.JPEG;*.PNG</patterns>
	<image-files/>
</action>
</actions>
