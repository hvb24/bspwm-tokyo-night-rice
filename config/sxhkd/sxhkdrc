####################################
#          GLOBAL HOTKEYS         #
####################################

# Open Alacritty terminal
super + Return
    alacritty

# Launch combined launcher (windows + apps + commands)
super + @space
    ~/.config/rofi/scripts/launcher.sh

# Reload sxhkd configuration
super + Escape
    pkill -USR1 -x sxhkd

####################################
#         BSPWM CONTROLS          #
####################################

# Quit/Restart bspwm
super + alt + {q,r}
    bspc {quit,wm -r}

# Close window/Kill node
super + q
    bspc node -{c,k}

# Toggle between tiled and monocle layout
super + m
    bspc desktop -l next

# Send marked node to preselected node
super + y
    bspc node newest.marked.local -n newest.!automatic.local

# Swap current node with biggest window
super + g
    bspc node -s biggest.window

####################################
#        WINDOW STATE/FLAGS       #
####################################

# Set window state (tiled/pseudo_tiled/floating/fullscreen)
super + {t,shift + t,s,f}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Toggle node flags (marked/locked/sticky/private)
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

####################################
#     FOCUS & WINDOW MOVEMENT     #
####################################

# Focus or swap window in direction
super + {_,shift + }{h,j,k,l}
    bspc node -{f,s} {west,south,north,east}

# Focus node via path jump
super + {p,b,comma,period}
    bspc node -f @{parent,brother,first,second}

# Focus next/previous window
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Focus next/previous desktop
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# Focus last node/desktop
super + {grave,Tab}
    bspc {node,desktop} -f last

# Focus older/newer node in history
super + {o,i}
    bspc wm -h off; \
    bspc node {older,newer} -f; \
    bspc wm -h on

# Focus or move to desktop 1-10
super + {_,shift + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

####################################
#           PRESELECTION          #
####################################

# Preselect split direction
super + ctrl + {h,j,k,l}
    bspc node -p {west,south,north,east}

# Preselect split ratio
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Cancel node preselection
super + ctrl + space
    bspc node -p cancel

# Cancel all desktop preselections
super + ctrl + shift + space
    bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

####################################
#     FLOATING MOVE / RESIZE      #
####################################

# Expand window edge
super + alt + {h,j,k,l}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Contract window edge
super + alt + shift + {h,j,k,l}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Move floating window
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

####################################
#          CUSTOMIZATION          #
####################################

# Set random wallpaper (fixed Tokyo Night palette, no pywal recolouring)
super + w
    ~/.config/theme/wallpaper.sh random

# Show keybindings popup
super + F1
    ~/.config/bspwm/scripts/show_keys.sh
####################################
#        APPS & MEDIA (rice)       #
####################################

# File manager
super + e
    thunar

# Browser
super + shift + b
    firefox

# Code editor
super + shift + d
    code

# Volume up/down/mute
XF86Audio{RaiseVolume,LowerVolume}
    pactl set-sink-volume @DEFAULT_SINK@ {+5%,-5%}

XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

####################################
#         ROFI MENUS (rice)        #
####################################

# Window switcher
alt + Tab
    rofi -show window -m -4

# Run a shell command
super + shift + space
    rofi -show run -m -4

# File browser
super + shift + f
    rofi -show filebrowser -m -4

# Power menu
super + shift + q
    ~/.config/rofi/scripts/powermenu.sh

# Wallpaper picker
super + shift + w
    ~/.config/rofi/scripts/wallpaper-picker.sh

# App grid (fullscreen Launchpad-style)
super + shift + a
    ~/.config/rofi/scripts/appgrid.sh
