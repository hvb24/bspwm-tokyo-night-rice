/* Wallpaper picker: thumbnail grid. Inherits the launcher look. */
@import "custom.rasi"

window { width: 1100px; y-offset: 0px; }
mainbox { children: [ inputbar, listview ]; }
inputbar { children: [ prompt, entry ]; }
listview { columns: 4; lines: 3; spacing: 12px; fixed-height: true; flow: horizontal; }
element { orientation: vertical; padding: 8px; spacing: 6px; }
element { border-radius: 12px; }
element-icon { size: 12em; horizontal-align: 0.5; }
element-text { enabled: false; }   /* filenames are hashes; still searchable */
element selected.normal { background-color: @accent; }
